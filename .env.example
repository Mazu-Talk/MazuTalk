# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false
# VITE_API_BASE=/api/v1
# VITE_WS_BASE=ws://localhost:8000/api/v1

# Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_DB_PATH=:memory:

# LLM (Ollama 사이드카). 비우면 규칙기반 fallback 으로 동작.
OLLAMA_URL=http://ollama:11434
LLM_MODEL=mazutalk
AI_SERVICE_TIMEOUT=120
RP_PROMPT_PATH=/app/ai_prompts/RP_system_prompt_runtime.md
STT_MODEL=/app/models/stt
STT_MODEL_HOST_PATH=./ai/stt/models/faster-whisper-medium-child-lora-int8
STT_FALLBACK_MODEL=medium
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=3
TTS_DEVICE=auto
TTS_OUTPUT_DIR=output_audio
