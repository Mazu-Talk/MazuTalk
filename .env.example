# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false
# Optional explicit overrides (normally derived from VITE_API_BASE_URL)
# VITE_API_BASE=/api/v1
# VITE_WS_BASE=ws://localhost:8000/api/v1

# Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
AI_SERVICE_URL=
SESSION_DB_PATH=:memory:
STT_MODEL=medium
STT_FALLBACK_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_DEVICE=auto
TTS_OUTPUT_DIR=output_audio

# Optional external AI/LLM service
# AI_SERVICE_URL=http://localhost:9000
